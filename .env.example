# URL base do projeto Supabase — SEM caminho no final (nada de /rest/v1/).
# Encontrada em: Supabase Dashboard > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave publicável (publishable key) do Supabase — pode ficar exposta no frontend,
# o acesso real é controlado pelas policies de RLS no banco.
# Encontrada em: Supabase Dashboard > Project Settings > API Keys > Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
